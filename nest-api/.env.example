HOST=127.0.0.1
PORT=3004
NODE_ENV=development

# Existing MySQL database; no schema reset or recreation is required.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/shopsphere"
CSRF_SECRET=replace-with-at-least-32-random-characters

# Customer email OTP via SMTP. For Gmail, use an App Password and STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-verified-sender@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM="ShopSphere <your-verified-sender@gmail.com>"

# Product image storage. Missing values disable Cloudinary upload operations.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Razorpay checkout and webhook verification.
RAZORPAY_KEY_ID=your-test-key-id
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
STORE_CURRENCY=INR
# Applies to every product; stored catalog prices are treated as tax-exclusive.
GST_RATE_PERCENT=18

# Admin and manager sign-in use existing database accounts/roles. Do not put
# privileged account passwords in this file.
# One-time seed environment names (supply only to the seed process):
# ADMIN_NAME, ADMIN_EMAIL, ADMIN_PASSWORD
# MANAGER_NAME, MANAGER_EMAIL, MANAGER_PASSWORD
# EXPECTED_DATABASE_HOST, EXPECTED_DATABASE_NAME
